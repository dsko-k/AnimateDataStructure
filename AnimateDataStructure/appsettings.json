{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.Hosting": "Information",
      "Microsoft.AspNetCore.Mvc": "Information"
    }
  },
  // 2. Serilog Configuration
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      // Wrap the File sink with the 'Async' sink to prevent deadlocks
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "logs/appLog.txt",
                "rollingInterval": "Day",
                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId" ]
  },

  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=CleanAnimationDatastructure;Trusted_Connection=True;MultipleActiveResultSets=true"
  },


  "DataStructures": {
    "Cards": [
      {
        "Id": "idCardBinarySearchTree",
        "Title": "Binary Search Tree",
        "Description": "Organizes data for efficient searching"
      },
      {
        "Id": "idCardAvlTree",
        "Title": "AVL Tree",
        "Description": "A balanced binary search tree for efficient storing and retrieving"
      },
      {
        "Id": "idCardMinHeap",
        "Title": "Min Heap",
        "Description": "A tree where parent nodes are smaller than children"
      },
      {
        "Id": "idCardMaxHeap",
        "Title": "Max Heap",
        "Description": "A tree where parent nodes are greater than children"
      },
      {
        "Id": "idCardRedBlackTree",
        "Title": "Red-Black Tree",
        "Description": "A balanced binary search tree with color properties"
      },
      {
        "Id": "idCardHistory",
        "Title": "History",
        "Description": "Your saved data structures"
      }
    ]
  }

}
