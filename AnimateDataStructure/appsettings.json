{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.Hosting": "Information",
      "Microsoft.AspNetCore.Mvc": "Information"
    }
  },
  // 2. Serilog Configuration
  "Serilog": {
    "MinimumLevel": {
      // Set the default minimum logging level for Serilog
      "Default": "Information",
      "Override": {
        // Suppress verbose logs from Microsoft components
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }, // Writes logs to the console
      {
        "Name": "File",
        "Args": {
          "path": "logs/appLog.txt", // The file path for logs
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    // Optional: Add contextual information to logs
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId" ]
  },

  // Existing Application Configuration
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=CleanAnimationDatastructure;Trusted_Connection=True;MultipleActiveResultSets=true"
  }
}
