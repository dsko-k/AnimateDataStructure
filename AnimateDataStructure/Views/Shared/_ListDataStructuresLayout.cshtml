@model List<AnimateDataStructure.Core.Entities.CardEntities.DataStructureListCard>
@{
    ViewData["Title"] = "Data Structure Animation";
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AspNetCore_DataStructureAnimation</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link rel="stylesheet" href="/css/listDataStructuresStyles.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/authenticationFormsStyles.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/buttonAuthenticateStyles.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/gradientTextStyles.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/userAgentNotificationStyles.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/scrollListDataStructuresStyles.css" asp-append-version="true" />
</head>

<body id="idBody">

    @await Html.PartialAsync("_UserAgentNotification")

    <div id="idInpuntContainer" class="inputWithButtonsContainer">
        @await Html.PartialAsync("_AuthenticateButton")
    </div>

    <div id="idAuthorizationSuperContainer" class="authorizationSuperContainer"></div>

    <div class="header-container">
        <h1 class="gradient-text">Animate data structures</h1>
    </div>

    <div id="idCardsContainer" class="cardsContainer">
        @foreach (var card in Model)
        {
            @await Html.PartialAsync("_DataStructureCard", card)
        }
    </div>

    @*
    <a id="source-link" class="link" href="https://github.com/" target="_blank">
        <i class="fa-solid fa-link"></i>
        <span class="roboto-mono">Source</span>
    </a>
    *@
    
    <a id="youtube-link" class="link" href="https://www.youtube.com/watch?v=TJcG9jkBmnQ" target="_blank">
        <i class="fa-brands fa-youtube"></i>
        <span>Project overview</span>
    </a>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @await Html.PartialAsync("_ListDataStructuresScroll");
    

    @await RenderSectionAsync("Scripts", required: true)
</body>
</html>