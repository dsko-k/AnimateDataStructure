@using AnimateDataStructure.Web.Constants
@{
    Layout = "_DataStructureLayout";

    //ViewData["ControllerName"] = ViewContext?.RouteData?.Values["controller"]?.ToString(); //"AvlTree";
    ViewData[ViewDataKeys.ControllerName] = ViewContext?.RouteData?.Values[ViewDataKeys.Controller]?.ToString(); //"AvlTree";
    ViewData[ViewDataKeys.ActionNameAddNode] = ActionNames.AddNode; /* Add correspondent data-attributes for each button using Razor-syntax */
    ViewData[ViewDataKeys.ActionNameFindNode] = ActionNames.FindNode;
    ViewData[ViewDataKeys.ActionNameDeleteNode] = ActionNames.DeleteNode;
    ViewData[ViewDataKeys.ActionNameTraverseInorder] = ActionNames.TraverseInorder;
    ViewData[ViewDataKeys.ActionNameTraversePreorder] = ActionNames.TraversePreorder;
    ViewData[ViewDataKeys.ActionNameTraversePostorder] = ActionNames.TraversePostorder;
    ViewData[ViewDataKeys.ActionNameSaveNodes] = ActionNames.SaveNodes;
}


@section Scripts {
    <script type="module" src="~/js/mainAvlTree.js" defer></script>
}



